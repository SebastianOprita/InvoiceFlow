<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
		<PackageVersion Include="MessagePack" Version="2.5.307" />
	</ItemGroup>

	<ItemGroup>
		<PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.5" />

		<PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
		<PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="11.0.0" />

		<PackageVersion Include="FluentValidation" Version="12.2.0" />
		<PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="11.0.0"  />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="11.0.0" />

		<PackageVersion Include="Moq" Version="4.21.0" />
		<PackageVersion Include="FluentAssertions" Version="8.11.0" />
		<PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
		<PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
		<PackageVersion Include="xunit.v3" Version="4.0.3" />
		<PackageVersion Include="Respawn" Version="7.0.0" />
		<PackageVersion Include="coverlet.MTP" Version="10.1.0" />
		<PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
		<PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
		<PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
		
		<!-- InvoiceFlow BuildingBlocks -->
		<PackageVersion Include="InvoiceFlow.BuildingBlocks.Domain" Version="1.0.0" />
		<PackageVersion Include="InvoiceFlow.BuildingBlocks.Api" Version="1.0.0" />
		<PackageVersion Include="InvoiceFlow.BuildingBlocks.Application" Version="1.0.0" />
		<PackageVersion Include="InvoiceFlow.BuildingBlocks.Authorization" Version="1.1.0" />
		<PackageVersion Include="InvoiceFlow.BuildingBlocks.Currency" Version="1.0.0" />

		<PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
	</ItemGroup>
	
</Project>
