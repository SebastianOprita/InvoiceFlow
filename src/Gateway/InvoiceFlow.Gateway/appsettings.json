{
  "ReverseProxy": {
    "Routes": {
      "identity-platform-auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/platform/auth/{**catch-all}"
        }
      },
      "identity-platform-users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/platform/users/{**catch-all}"
        }
      },
      "identity-platform-tenants": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/platform/tenants/{**catch-all}"
        }
      },
      "identity-tenant-auth": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/{tenantId:guid}/auth/{**catch-all}"
        }
      },
      "identity-tenant-roles": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/{tenantId:guid}/roles/{**catch-all}"
        }
      },
      "identity-tenant-users": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/{tenantId:guid}/users/{**catch-all}"
        }
      },
      "identity-errors": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/errors",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/api/errors" }
        ]
      },
      "identity-permissions": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/permissions"
        },
        "Transforms": [
          {
            "PathSet": "/api/permissions"
          }
        ]
      },
      "customers": {
        "ClusterId": "customers",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/{tenantId}/customers/{**catch-all}"
        }
      },
      "customers-errors": {
        "ClusterId": "customers",
        "Match": {
          "Path": "/api/customers/errors",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/api/errors" }
        ]
      },
      "products": {
        "ClusterId": "products",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/{tenantId}/products/{**catch-all}"
        }
      },
      "products-errors": {
        "ClusterId": "products",
        "Match": {
          "Path": "/api/products/errors",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/api/errors" }
        ]
      },
      "invoices": {
        "ClusterId": "invoices",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/{tenantId}/invoices/{**catch-all}"
        }
      },
      "invoices-errors": {
        "ClusterId": "invoices",
        "Match": {
          "Path": "/api/invoices/errors",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/api/errors" }
        ]
      },
      "payments": {
        "ClusterId": "payments",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/{tenantId}/payments/{**catch-all}"
        }
      },
      "payments-errors": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/payments/errors",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/api/errors" }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://invoiceflow-identity-api/"
          }
        }
      },
      "customers": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://invoiceflow-customers-api/"
          }
        }
      },
      "invoices": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://invoiceflow-invoices-api/"
          }
        }
      },
      "payments": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://invoiceflow-payments-api/"
          }
        }
      },
      "products": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://invoiceflow-products-api/"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
