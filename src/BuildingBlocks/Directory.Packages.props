<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<PackageVersion Include="MediatR" Version="14.2.0" />
		<PackageVersion Include="FluentValidation" Version="12.1.1" />
		<PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
		<PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
		<PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
		<PackageVersion Include="xunit.v3" Version="4.0.1" />
		<PackageVersion Include="Moq" Version="4.21.0" />
		<PackageVersion Include="coverlet.MTP" Version="10.0.1" />
		<PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
		<PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
		<PackageVersion Include="FluentAssertions" Version="8.11.0" />
		<PackageVersion Include="MassTransit" Version="9.2.2" />

		<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
