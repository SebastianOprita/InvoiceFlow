<Project>
  <PropertyGroup>
    <IsPackable>true</IsPackable>

	<Authors>Sebastian Oprita</Authors>
	<Company>SebastianOprita</Company>
	<Product>InvoiceFlow</Product>
	<Copyright>Copyright © Sebastian Oprita. All rights reserved.</Copyright>

    <RepositoryUrl>https://github.com/SebastianOprita/InvoiceFlow</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

</Project>