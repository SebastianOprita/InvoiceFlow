<?xml version="1.0" encoding="utf-8"?>

<configuration>
	<packageSources>
		<clear />

		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

		<add key="InvoiceFlow" value="https://nuget.pkg.github.com/SebastianOprita/index.json" />
	</packageSources>

	<packageSourceMapping>

		<packageSource key="InvoiceFlow">
			<package pattern="InvoiceFlow.*" />
		</packageSource>

		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>

	</packageSourceMapping>


</configuration>
