
GET https://localhost:5000/api/identity/errors

###
GET https://localhost:5000/api/identity/permissions
Authorization: Bearer {{login.response.body.$.accessToken}}

###
# @name login
POST https://localhost:5000/api/f305e3f0-e634-470b-b9c1-cc0c7559dc0a/auth/login
Content-Type: application/json
{
  "email": "admin@email.com",
  "password": "admin"
}

###
# @name refresh
POST https://localhost:5000/api/f305e3f0-e634-470b-b9c1-cc0c7559dc0a/auth/refresh
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json
{
  "refreshToken":"{{login.response.body.$.refreshToken}}"
}

###
POST https://localhost:5000/api/f305e3f0-e634-470b-b9c1-cc0c7559dc0a/auth/logout
Authorization: Bearer {{refresh.response.body.$.accessToken}}
Content-Type: application/json
{
  "refreshToken":"{{refresh.response.body.$.refreshToken}}"
}