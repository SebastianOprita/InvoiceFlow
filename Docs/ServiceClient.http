@tenantId=f305e3f0-e634-470b-b9c1-cc0c7559dc0a
@clientId=invoice-flow-client
@clientSecret=admin

GET https://localhost:5000/api/identity/errors

### Request a service-client access token
# @name serviceClientToken
POST https://localhost:5000/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials&client_id={{clientId}}&client_secret={{clientSecret}}&tenant_id={{tenantId}}

### Get customers
GET https://localhost:5000/api/{{tenantId}}/customers
Authorization: Bearer {{serviceClientToken.response.body.$.access_token}}

### Get products
GET https://localhost:5000/api/{{tenantId}}/products
Authorization: Bearer {{serviceClientToken.response.body.$.access_token}}

### Get invoices
GET https://localhost:5000/api/{{tenantId}}/invoices
Authorization: Bearer {{serviceClientToken.response.body.$.access_token}}

### Get payments
GET https://localhost:5000/api/{{tenantId}}/payments
Authorization: Bearer {{serviceClientToken.response.body.$.access_token}}
